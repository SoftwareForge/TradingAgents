@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject Services.MarkdownRenderService MarkdownRenderer

<PageTitle>Trading Manager</PageTitle>

<h1>Trading Manager MVP</h1>
<p>Steuerung fuer TradingAgents API und LM Studio Modellwahl.</p>

<div class="layout-grid">
    <section class="card section-card">
        <div class="card-body">
            <h5 class="card-title">Init &amp; Settings</h5>

            <div class="settings-grid">
                <div class="settings-block">
                    <h6>API</h6>
                    <div class="icon-btn-row">
                        <button class="btn btn-success icon-btn" title="API starten" aria-label="API starten" @onclick="StartApi">
                            <span class="icon-glyph">▶</span>
                        </button>
                        <button class="btn btn-danger icon-btn" title="API stoppen" aria-label="API stoppen" @onclick="StopApi">
                            <span class="icon-glyph">■</span>
                        </button>
                        <button class="btn btn-outline-secondary icon-btn" title="Status aktualisieren" aria-label="Status aktualisieren" @onclick="RefreshStatus">
                            <span class="icon-glyph">↻</span>
                        </button>
                    </div>
                    <div class="status-inline">
                        <span><strong>Laeuft:</strong> @(_status?.TradingAgentsApi.IsRunning == true ? "Ja" : "Nein")</span>
                        <span><strong>PID:</strong> @(_status?.TradingAgentsApi.Pid?.ToString() ?? "-")</span>
                        <span><strong>Base URL:</strong> @(_status?.TradingAgentsApi.BaseUrl ?? "-")</span>
                    </div>
                </div>

                <div class="settings-block">
                    <h6>Model</h6>
                    <div class="model-actions">
                        <button class="btn btn-outline-primary icon-btn" title="Modelle laden" aria-label="Modelle laden" @onclick="LoadModels">
                            <span class="icon-glyph">↻</span>
                        </button>
                        <button class="btn btn-success" @onclick="LoadModelInLmStudio" disabled="@string.IsNullOrWhiteSpace(_selectedLoadModel)">Laden + setzen</button>
                        <button class="btn btn-outline-success" @onclick="SetModelsOnly" disabled="@(!HasAnyModelSelection)">Modelle setzen</button>
                        <button class="btn btn-outline-danger" @onclick="UnloadModelInLmStudio">Auswerfen</button>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label" for="contextLengthInput">Context Length</label>
                            <select id="contextLengthInput" class="form-select" @bind="_contextLengthLabel">
                                @foreach (var option in _contextLengthOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="maxConcurrentInput">Max Concurrent (optional)</label>
                            <input id="maxConcurrentInput" type="number" min="1" class="form-control" @bind="_maxConcurrent" />
                        </div>
                    </div>
                    <select class="form-select mb-2" @bind="_selectedLoadModel">
                        <option value="">-- Modell auswaehlen --</option>
                        @foreach (var model in _models)
                        {
                            <option value="@model">@model</option>
                        }
                    </select>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label" for="smallModelInput">Small Model</label>
                            <select id="smallModelInput" class="form-select" @bind="_selectedSmallModel">
                                <option value="">-- Small Model --</option>
                                @foreach (var model in _models)
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="largeModelInput">Large Model</label>
                            <select id="largeModelInput" class="form-select" @bind="_selectedLargeModel">
                                <option value="">-- Large Model --</option>
                                @foreach (var model in _models)
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mt-2">
                        <strong>Aktiv:</strong> S: @(_status?.SmallModel ?? "-") | L: @(_status?.LargeModel ?? "-")
                    </div>
                </div>

                <div class="settings-block">
                    <h6>Run Settings</h6>
                    <div class="run-form-grid">
                        <div>
                            <label class="form-label" for="tickerInput">Ticker</label>
                            <input id="tickerInput" class="form-control" @bind="_ticker" placeholder="z.B. NVDA" />
                        </div>
                        <div>
                            <label class="form-label" for="dateInput">Datum</label>
                            <input id="dateInput" type="date" class="form-control" @bind="_analysisDateValue" />
                        </div>
                        <div>
                            <label class="form-label" for="langInput">Sprache</label>
                            <select id="langInput" class="form-select" @bind="_language">
                                @foreach (var lang in _languages)
                                {
                                    <option value="@lang">@lang</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="depthInput">Research Depth</label>
                            <select id="depthInput" class="form-select" @bind="_researchDepthLabel">
                                @foreach (var depth in _researchDepthOptions)
                                {
                                    <option value="@depth">@depth</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="verbosityInput">Report Verbosity</label>
                            <select id="verbosityInput" class="form-select" @bind="_reportVerbosity">
                                @foreach (var v in _reportVerbosityOptions)
                                {
                                    <option value="@v">@v</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="run-actions mt-2">
                        <button class="btn btn-warning icon-btn" title="@(HasActiveRun ? "Neuen Run in Queue stellen" : "TradingAgents starten")" aria-label="TradingAgents starten" @onclick="StartAnalysis">
                            <span class="icon-glyph">▶</span>
                        </button>
                        <button class="btn btn-outline-danger icon-btn" title="Analyse stoppen" aria-label="Analyse stoppen" @onclick="CancelAnalysis" disabled="@string.IsNullOrWhiteSpace(_jobId)">
                            <span class="icon-glyph">■</span>
                        </button>
                        <button class="btn btn-outline-primary icon-btn" title="@(_streaming ? "Stream stoppen" : "Stream starten")" aria-label="@(_streaming ? "Stream stoppen" : "Stream starten")" @onclick="ToggleEventStream" disabled="@string.IsNullOrWhiteSpace(_jobId)">
                            <span class="icon-glyph">@(_streaming ? "■" : "▶")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card section-card">
        <div class="card-body">
            <h5 class="card-title">Active Run</h5>
            <div class="active-run-meta">
                <span><strong>Job ID:</strong> @(_jobId ?? "-")</span>
                <span><strong>Status:</strong> @_liveJobStatus</span>
                <span><strong>Progress:</strong> @_liveJobProgress%</span>
                @if (!string.IsNullOrWhiteSpace(_queueInfo))
                {
                    <span><strong>Queue:</strong> @_queueInfo</span>
                }
            </div>
            <div class="telemetry-line mb-2">
                Agents: @_agentsCompleted/@_agentsTotal |
                LLM: @_llmCalls |
                Tools: @_toolCalls |
                Tokens: @FormatToken(_promptTokens)↑ @FormatToken(_completionTokens)↓ |
                Reports: @_reportsCompleted/@_reportsTotal |
                ⏱ @FormatElapsed()
            </div>

            <div class="card mb-3">
                <div class="card-body progress-window">
                    <h6 class="card-title">Progress Window</h6>
                    <div class="row g-3">
                        @foreach (var team in _progressTeams)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="team-card h-100">
                                    <div class="team-title">@team.TeamName</div>
                                    @foreach (var agent in team.Agents)
                                    {
                                        <div class="agent-row">
                                            <span class="agent-name">@agent.AgentName</span>
                                            <span class="status-badge @GetStatusCss(agent.Status)">@agent.Status</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="active-run-grid">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Trading Signals</h6>
                        @if (_signals.Count == 0)
                        {
                            <p class="text-muted mb-0">Noch keine Signale erkannt.</p>
                        }
                        else
                        {
                            var recommendation = ComputeSignalRecommendation();
                            var buyCount = GetSignalCount("BUY");
                            var holdCount = GetSignalCount("HOLD");
                            var sellCount = GetSignalCount("SELL");

                            <div class="signal-overview mb-2">
                                <span class="signal-badge signal-large @recommendation.CssClass">@recommendation.Label (@recommendation.Percent%)</span>
                                <span class="signal-summary-text">Buy x@(buyCount) | Hold x@(holdCount) | Sell x@(sellCount)</span>
                            </div>

                            <div class="mb-2">
                                @foreach (var signal in _signals.OrderByDescending(s => s.UpdatedAt).Take(10))
                                {
                                    <div class="signal-row">
                                        <span class="signal-badge @GetSignalCss(signal.Signal)">@signal.Signal</span>
                                        <span class="signal-source">@signal.Source</span>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => OpenSignalDetails(signal))">Details</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Live Key Metrics</h6>
                        @if (_keyMetrics.Count == 0)
                        {
                            <p class="text-muted mb-0">Noch keine Metriken erkannt.</p>
                        }
                        else
                        {
                            <ul class="metrics-compact-list mb-0">
                                @foreach (var metric in _keyMetrics.OrderBy(m => m.Key))
                                {
                                    <li title="Updated: @metric.Value.UpdatedAt">
                                        <span class="metric-key">@metric.Key</span>: <span class="metric-value">@metric.Value.Value</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="card-title mb-0">Summary</h6>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => _renderSummaryMarkdown = !_renderSummaryMarkdown)">
                                @(_renderSummaryMarkdown ? "Raw" : "Markdown")
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_summaryText))
                        {
                            @if (_renderSummaryMarkdown)
                            {
                                <div class="mt-1 p-2 bg-light border overflow-safe-block markdown-content">@((MarkupString)MarkdownRenderer.ToSafeHtml(_summaryText))</div>
                            }
                            else
                            {
                                <pre class="mt-1 p-2 bg-light border overflow-safe-block">@_summaryText</pre>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Noch keine Summary verfuegbar.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-title mb-0">Live Output</h6>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => _showLogsModal = true)">Logs</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_eventStreamText))
                    {
                        <pre class="mt-1 p-2 bg-light border overflow-safe-block live-output">@_eventStreamText</pre>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Noch kein Stream-Output vorhanden.</p>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a class="btn btn-outline-primary btn-sm" href="/runs">Zur Run-History</a>
            </div>
        </div>
    </section>
</div>

@if (_showLogsModal)
{
    <div class="logs-modal-backdrop" @onclick="@(() => _showLogsModal = false)">
        <div class="logs-modal-card" @onclick:stopPropagation="true">
            <div class="logs-modal-header">
                <h5 class="mb-0">Logs / Raw JSON</h5>
                <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => _showLogsModal = false)">Schliessen</button>
            </div>
            <div class="logs-modal-body">
                @if (!string.IsNullOrWhiteSpace(_jobStatusJson))
                {
                    <h6 class="mt-2">Job Status JSON</h6>
                    <pre class="mt-1 p-2 bg-light border overflow-safe-block">@_jobStatusJson</pre>
                }
                @if (!string.IsNullOrWhiteSpace(_jobResultJson))
                {
                    <h6 class="mt-2">Job Result JSON</h6>
                    <pre class="mt-1 p-2 bg-light border overflow-safe-block">@_jobResultJson</pre>
                }
                @if (string.IsNullOrWhiteSpace(_jobStatusJson) && string.IsNullOrWhiteSpace(_jobResultJson))
                {
                    <p class="text-muted mb-0">Noch keine JSON-Logs vorhanden.</p>
                }
            </div>
        </div>
    </div>
}

@if (_showSignalDetailsModal && _selectedSignal is not null)
{
    <div class="logs-modal-backdrop" @onclick="@(() => _showSignalDetailsModal = false)">
        <div class="logs-modal-card" @onclick:stopPropagation="true">
            <div class="logs-modal-header">
                <h5 class="mb-0">Signal Details</h5>
                <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => _showSignalDetailsModal = false)">Schliessen</button>
            </div>
            <div class="logs-modal-body">
                <p><strong>Signal:</strong> <span class="signal-badge @GetSignalCss(_selectedSignal.Signal)">@_selectedSignal.Signal</span></p>
                <p><strong>Quelle:</strong> @_selectedSignal.Source</p>
                <p><strong>Zeit:</strong> @_selectedSignal.UpdatedAt.ToString("u")</p>
                <h6>Kontext</h6>
                <pre class="mt-1 p-2 bg-light border overflow-safe-block">@_selectedSignal.Context</pre>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-secondary" role="alert">
        @_message
    </div>
}
